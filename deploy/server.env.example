# /etc/up2date/server.env (chmod 600)

# Where Up2Date listens. Keep it on localhost or the LAN and put a reverse proxy with TLS in front.
UP2DATE_LISTEN=127.0.0.1:8080
# The address people and agents open; the OIDC redirect URI is <this>/auth/callback
UP2DATE_PUBLIC_URL=https://up2date.example.com

UP2DATE_OIDC_ISSUER=https://id.example.com
UP2DATE_OIDC_CLIENT_ID=
UP2DATE_OIDC_CLIENT_SECRET=
# UP2DATE_OIDC_SCOPES=openid profile email groups
# UP2DATE_OIDC_GROUPS_CLAIM=groups

# Who may sign in (at least one is required): sub, email or preferred_username, and/or groups
UP2DATE_ALLOWED_USERS=
UP2DATE_ALLOWED_GROUPS=homelab_admins

# Defaults shown
# UP2DATE_STALE_HOURS=24          (a host that has not reported for this long needs attention)
# UP2DATE_STATE_DIR=/var/lib/up2date
