# The dashboard: /etc/systemd/system/up2date.service
# Settings go in /etc/up2date/server.env (root-only); hosts and their reports in /var/lib/up2date.
[Unit]
Description=Up2Date, a dashboard of pending updates
Wants=network-online.target
After=network-online.target

[Service]
ExecStart=/usr/local/bin/up2date serve
EnvironmentFile=/etc/up2date/server.env
DynamicUser=yes
StateDirectory=up2date
StateDirectoryMode=0700
UMask=0077
Restart=on-failure
RestartSec=5
MemoryMax=128M

# It needs its state directory and the network, nothing else
NoNewPrivileges=yes
CapabilityBoundingSet=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateUsers=yes
ProtectHostname=yes
ProtectClock=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources

[Install]
WantedBy=multi-user.target
