# /etc/up2date/discovery.env (root only)
UP2DATE_URL=https://up2date.example.com
# Same long random secret as UP2DATE_ENROLLMENT_SECRET on the dashboard.
UP2DATE_ENROLLMENT_SECRET=
# Space- or comma-separated VMIDs, names, or lxc/VMID and qemu/VMID.
# Empty include means all running guests. Exclude always takes precedence.
UP2DATE_INCLUDE=
UP2DATE_EXCLUDE=
# Whether the agents installed in guests install new releases themselves: off, all or same-major.
UP2DATE_UPDATE=off
